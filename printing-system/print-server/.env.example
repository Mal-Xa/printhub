# HTTP server
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# CORS
CORS_ORIGIN=*

# File storage
UPLOAD_DIR=./uploads
MAX_DOCUMENT_SIZE_BYTES=104857600

# WebSocket
WS_PATH=/ws

# Fully-qualified base URL other services (print-agent, print-client)
# use to reach this server. Required in any multi-machine deployment --
# "host" above is just a bind address (0.0.0.0), not a usable URL host.
# Used to build the download URL for uploaded documents
# (GET {PUBLIC_BASE_URL}/api/files/:fileId) that print-agent fetches.
PUBLIC_BASE_URL=http://localhost:4000

# Logging
LOG_LEVEL=info

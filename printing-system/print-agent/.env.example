# Copy to .env and fill in real values. See src/config/env.ts for full
# validation rules and defaults.

# --- Required ---------------------------------------------------------------

# Base URL of print-server's REST API (no trailing slash needed).
PRINT_SERVER_HTTP_URL=http://localhost:4000

# print-server's WebSocket endpoint.
PRINT_SERVER_WS_URL=ws://localhost:4000/ws

# Shared secret sent as the x-api-key header on every request.
PRINT_SERVER_API_KEY=changeme

# --- Optional -----------------------------------------------------------

# Overrides os.hostname() if set. Useful when several agents share a
# hostname (e.g. containers) or you want a friendlier display name.
# AGENT_HOSTNAME=front-desk-printer-agent

# Where agent-local state (identity, queue, printer cache, downloads)
# is persisted. Defaults to /var/lib/print-agent when running as root
# (typical under systemd), otherwise ~/.local/state/print-agent.
# AGENT_STATE_DIR=/var/lib/print-agent

# trace | debug | info | warn | error
LOG_LEVEL=info

# How often (seconds) to re-scan local printers via CUPS.
PRINTER_DETECTION_INTERVAL_SECONDS=60

# How often (ms) the local queue worker ticks.
QUEUE_POLL_INTERVAL_MS=3000

# How often (seconds) the temp-file cleanup sweep runs.
CLEANUP_INTERVAL_SECONDS=600

# Orphaned downloaded files older than this (minutes) are deleted by
# the cleanup sweep, even if their job record was somehow lost.
TEMP_FILE_MAX_AGE_MINUTES=120

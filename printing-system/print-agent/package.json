{
  "name": "print-agent",
  "version": "1.0.0",
  "description": "Background agent service: connects to print-server over WebSocket/HTTP, manages a local print queue, detects local printers, and executes print jobs via the OS printing system (CUPS).",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "start": "node dist/main.js",
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "print-common": "*",
    "zod": "^3.23.8",
    "ws": "^8.18.0",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/ws": "^8.5.10",
    "typescript": "^5.5.4",
    "ts-node-dev": "^2.0.0",
    "rimraf": "^5.0.7",
    "@typescript-eslint/eslint-plugin": "^7.16.1",
    "@typescript-eslint/parser": "^7.16.1",
    "eslint": "^8.57.0"
  },
  "engines": {
    "node": ">=18"
  }
}

# ============================================================
# Sora Print Hub — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# Server
PORT=4000
NODE_ENV=development

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Firebase Admin SDK
# Option A: Service account key file path (local dev)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Option B: Individual env vars (production / Cloud Run)
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Firebase Storage bucket (e.g. your-project.appspot.com)
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# Upload limits
MAX_FILE_SIZE_MB=50

# Signed URL expiry in minutes (for file downloads)
SIGNED_URL_EXPIRY_MINUTES=60

# Logging level: error | warn | info | debug
LOG_LEVEL=info

# ============================================================
# printing-system bridge (print-server)
# ============================================================
# Base URL of print-server's HTTP API — no trailing slash, no /api suffix.
PRINT_SERVER_URL=http://localhost:4000

# print-server requires a non-empty ownerId on every upload/job — it has no
# concept of individual Sora users, so every job is submitted under one
# fixed owner id representing this whole integration.
PRINT_SERVER_OWNER_ID=sora-print-hub

# How long (ms) the live printer-list proxy cache is considered fresh.
PRINT_SERVER_PRINTER_CACHE_TTL_MS=5000

# Timeout (ms) for any single HTTP call to print-server.
PRINT_SERVER_REQUEST_TIMEOUT_MS=8000

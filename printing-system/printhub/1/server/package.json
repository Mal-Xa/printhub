{
  "name": "sora-print-hub-server",
  "version": "1.0.0",
  "description": "Backend API server for Sora Print Hub — Express + Firebase Functions",
  "main": "lib/functions.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "start": "node lib/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "deploy": "npm run build && firebase deploy --only functions",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf lib"
  },
  "dependencies": {
    "adm-zip": "^0.5.10",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^6.0.0",
    "helmet": "^7.1.0",
    "pdf-lib": "^1.17.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "busboy": "^1.6.0",
    "uuid": "^9.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/busboy": "^1.5.4",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.7",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": "22"
  }
}
